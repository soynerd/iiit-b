    <script>
        const messages =<%- JSON.stringify(allMessages) %>;
        messages.reverse();
        const currentUser = "<%= currentUser %>";
        console.log(currentUser);
        console.log(messages);

        messages.map(message => {
          return (message.username === currentUser) ? createSenderMessage(currentUser, message.textmessage, message.dateandtime.substr(5, 5), message.dateandtime.substr(11, 5)) : createReceiverMessage(message.username, message.textmessage, message.dateandtime.substr(5, 5), message.dateandtime.substr(11, 5));
        })
        

        const currentUserMessages = messages.filter(message=>{
            return message.username === currentUser;
        });
        const otherUserMessages = messages.filter(message=>{
            return message.username != currentUser;
        });


        // const box = document.getElementById("box");

        function createSenderMessage(username, message, date, time, op = 0){
            

            const senderMessage = document.createElement("div");
            senderMessage.classList.add("sender-message");

            const replyAndMessage = document.createElement("div");
            replyAndMessage.classList.add("sender-mess-thread");

            const replyButton = document.createElement("a");
            replyButton.classList.add("button-6","w-button");
            replyButton.setAttribute("data-w-id", "d995570f-1c93-2301-6ca2-e78e559b8dd7");
            replyButton.style.opacity = "0";
            replyButton.href="#";
            replyButton.innerHTML=""; // "reply" text

            const userMessageDiv = document.createElement("div");
            userMessageDiv.classList.add("send-text-mess");
            userMessageDiv.setAttribute("data-w-id", "fae4a5fa-b1e2-14d9-bbe8-097947066194");

            

            const userMessage = document.createElement("p");
            userMessage.classList.add("paragraph-2");
            userMessage.innerHTML=message;

            

            userMessage

            userMessageDiv.appendChild(userMessage);

            replyAndMessage.appendChild(replyButton);
            replyAndMessage.appendChild(userMessageDiv);

            
            const usernameAndTime = document.createElement("div");
            usernameAndTime.classList.add("sender-mess-thread");

            const usernameHover = document.createElement("p");
            (!op)?usernameHover.classList.add("username"):usernameHover.classList.add("username-clone");
            (!op)?usernameHover.style.opacity="0":usernameAndTime.style.opacity="1";
            usernameHover.innerHTML="@"+username;

            const dateTime = document.createElement("p");
            dateTime.style.fontSize = "9px";
            dateTime.innerHTML = date + " " + time;

            usernameAndTime.appendChild(usernameHover);
            usernameAndTime.appendChild(dateTime);
            


            senderMessage.appendChild(replyAndMessage);
            senderMessage.appendChild(usernameAndTime);

            const box = document.getElementById("box");
            box.appendChild(senderMessage);
        }

        function createReceiverMessage(username, message, date, time, op = 0){
          const reciverMessage = document.createElement("div");
          reciverMessage.classList.add("recieved-message");

          const reciverMessageBox = document.createElement("div");
          reciverMessageBox.classList.add("reci-mess-thread");
          

          const messBox = document.createElement("div");
          messBox.classList.add("rec-text-mess");
          messBox.setAttribute("data-w-id","fae4a5fa-b1e2-14d9-bbe8-09794706619a");
          
          const messageContent = document.createElement("p");
          messageContent.classList.add("paragraph-4");
          messageContent.innerHTML = message;


          messBox.appendChild(messageContent);

          const reply = document.createElement("a");
          reply.setAttribute("data-w-id", "f20ba1cc-588f-d5fa-c71b-7470b345ed66");
          reply.classList.add("button-7", "w-button");
          reply.href = "#";
          reply.style.opacity = "0";
          reply.innerHTML = "";   // "thread" text

          reciverMessageBox.appendChild(messBox);
          reciverMessageBox.appendChild(reply);

          const usernameAndTime = document.createElement("div");
          usernameAndTime.classList.add('reci-mess-thread');


          const usernameHover = document.createElement("p");
          (!op)?usernameHover.classList.add("username"):usernameHover.classList.add("username-clone");
          (!op)?usernameHover.style.opacity="0":usernameHover.style.opacity="1";
          usernameHover.innerHTML="@"+username;

          const dateTime = document.createElement("p");
          dateTime.style.fontSize = "9px";
          dateTime.innerHTML = date + " " + time;

          usernameAndTime.appendChild(dateTime);
          usernameAndTime.appendChild(usernameHover);
          

          reciverMessage.appendChild(reciverMessageBox);

          reciverMessage.appendChild(usernameAndTime);

          const box = document.getElementById("box");
          box.appendChild(reciverMessage);


        }

  const socket = io();

  const form = document.getElementById('shit');
  const input = document.getElementById('input');

  form.addEventListener('submit', (e) => {
    console.log("first");
    e.preventDefault();
    if (input.value) {
      console.log("seconm");
      socket.emit('chat message', input.value, currentUser);
      
      createSenderMessage(currentUser, input.value, new Date().getDate() + "/" + new Date().getMonth(), new Date().getHours() + ":" + new Date().getMinutes(), 1);
      scroll();
      input.value = '';
    }
  });
  socket.on('chat message', (msg, username) => {
    console.log("recived from: ", username);
    createReceiverMessage(username, msg, new Date().getDate() + "/" + new Date().getMonth(), new Date().getHours() + ":" + new Date().getMinutes(), 1);
    scroll();
  });
  function sendUserDetails(){
    var temp = {"name": currentUser};
    socket.emit('user details', temp);
    //socket.emit('connected users', temp);
  }
  sendUserDetails();
  var i=0;
  while(i<1){
    socket.emit('connected users', "send");
    i++;
  }

  socket.on('connected users', (users)=>{
    console.log("hello");
    console.log(users);
    const removeChildren = document.getElementById('activeUsers');
    removeChildren.replaceChildren(); // Removes all children

    users.forEach((user)=>{
      createActiveUsers(user.name);
    });
  });

  function createActiveUsers(userName){
    const name = document.createElement("h6");
    name.classList.add("heading-3");
    name.innerHTML=userName;

    const activeUsers = document.getElementById("activeUsers");
    activeUsers.appendChild(name);
  }
  function scroll(){
    const chatBox = document.getElementById('box');
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  // setTimeout(scroll, 100);
   
  window.onload = () => {
    const chatBox = document.getElementById('box');
    chatBox.scrollTop = chatBox.scrollHeight; // Start at the bottom
};

    </script>

